 import { classNameFactory } from "@utils/css";
 import { Guild, GuildMember, Role } from "@vencord/discord-types";
 import { PermissionOverwriteType } from "@vencord/discord-types/enums";
-import { extractAndLoadChunksLazy, findByPropsLazy } from "@webpack";
-import { GuildRoleStore } from "@webpack/common";
+import { findByCodeLazy } from "@webpack";
+import { GuildRoleStore, i18n, PermissionsBits } from "@webpack/common";
 
 import { PermissionsSortOrder, settings } from ".";
 
-export const loadGetGuildPermissionSpecMap = extractAndLoadChunksLazy([".PRIMARY,badgeTooltipDelay:"]);
-export const { getGuildPermissionSpecMap } = findByPropsLazy("getGuildPermissionSpecMap");
+interface PermissionSpec {
+    title: string;
+    description?: string | null;
+}
+
+const getPermissionTitle: (bit: bigint) => string = findByCodeLazy("Unknown permission. Did you provide a _single_ bit flag?");
+const getChannelPermissionSpecMap: (channel: { type: number; }, advancedMode: boolean, options: object) => Record<string, { title: string; description?: any; }> =
+    findByCodeLazy("VIEW_CHANNEL.toString()", "GUILD_CATEGORY");
+
+let specMap: Record<string, PermissionSpec> | undefined;
+
+export function getGuildPermissionSpecMap(_guild?: unknown) {
+    if (specMap) return specMap;
+
+    let channelSpecs: ReturnType<typeof getChannelPermissionSpecMap> = {};
+    try {
+        // A guild text channel has the most complete descriptions
+        channelSpecs = getChannelPermissionSpecMap({ type: 0 }, false, {});
+    } catch { }
+
+    const map: Record<string, PermissionSpec> = {};
+    for (const [name, bit] of Object.entries(PermissionsBits)) {
+        const key = String(bit);
+
+        let title = name;
+        try {
+            title = getPermissionTitle(bit);
+        } catch {
+            title = channelSpecs[key]?.title ?? name;
+        }
+
+        let description: string | null = null;
+        try {
+            const raw = channelSpecs[key]?.description;
+            if (raw != null) description = i18n.intl.string(raw);
+        } catch { }
+
+        map[key] = { title, description };
+    }
+
+    return specMap = map;
+}
 
 export const cl = classNameFactory("vc-permviewer-");
 
